# --- Database (PostgreSQL 16, local) ---
# Replace <password> with your postgres superuser password (or a dedicated role).
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/clinicos?schema=public"

# --- Better Auth ---
# Generate with: npx auth secret (or openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# --- Business OS platform gateway (injected by the platform runtime) ---
# The mount point this app is served under; also baked into the build.
# SYSTEM_BASE_PATH="/clinicos"
# Shown to the browser and used by the auth client.
# NEXT_PUBLIC_BASE_PATH="/clinicos"
# Shared secret the platform signs its link token with.
# BOS_GATEWAY_SECRET="<shared-with-platform>"
# The one organization this process belongs to.
# BOS_ORG_ID="<organization-id>"
# BOS_ORG_SLUG="<organization-slug>"

# --- Storage (private uploads — never served statically) ---
STORAGE_DIR="./storage"

# --- Seed (development/demo only) ---
# SEED_ADMIN_EMAIL="admin@clinic.local"
# SEED_ADMIN_PASSWORD="ChangeMe!123"